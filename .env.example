# St. Elizabeth's High School Website — Environment Variables

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Resend API key for sending contact form emails
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email addresses
CONTACT_EMAIL=info@stelizabethhighschool.in
ADMISSIONS_EMAIL=admissions@stelizabethhighschool.in
PRINCIPAL_EMAIL=principal@stelizabethhighschool.in

# ============================================================================
# SCHOOL INFORMATION (Public)
# ============================================================================

NEXT_PUBLIC_FOUNDED_YEAR=1954
NEXT_PUBLIC_ENROLLMENT=185
NEXT_PUBLIC_RATIO=15
NEXT_PUBLIC_STAFF_COUNT=25
NEXT_PUBLIC_PHONE="0832-2954452"
NEXT_PUBLIC_OFFICE_PHONE="0832-2954452"
NEXT_PUBLIC_SCHOOL_LAT=15.2993
NEXT_PUBLIC_SCHOOL_LNG=74.1240

# ============================================================================
# SEO & SITE CONFIGURATION (Public)
# ============================================================================

NEXT_PUBLIC_SITE_URL=https://stelizabethhighschool.in

# ============================================================================
# SOCIAL MEDIA (Public - Optional)
# ============================================================================

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ============================================================================
# THIRD-PARTY SERVICES (Public Keys)
# ============================================================================

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Maps API (for embedded maps)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ============================================================================
# FEATURE FLAGS (Public)
# ============================================================================

NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SEARCH=true
NEXT_PUBLIC_ENABLE_NEWSLETTER=true

# ============================================================================
# RATE LIMITING (Server-side)
# ============================================================================

RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=3600000
SEARCH_RATE_LIMIT=60

# ============================================================================
# UPSTASH REDIS (for production rate limiting)
# ============================================================================

# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ============================================================================
# DEVELOPMENT FLAGS
# ============================================================================

# Use mock email sender in development (logs to console instead of sending)
USE_MOCK_EMAIL=true
