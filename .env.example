# St. Elizabeth's High School Website — Environment Variables

# Resend API key for sending contact form emails
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email address to receive contact form inquiries
CONTACT_EMAIL=info@stelizabeths.edu.in

# Static CSP nonce for JSON-LD structured data
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
NEXT_PUBLIC_CSP_NONCE=replace-with-generated-nonce
