# ============================================================================
# St. Elizabeth's High School — .env.local Template
# ============================================================================
# Copy to .env.local and fill in your values.
# The site works WITHOUT any of these — all features have static fallbacks.
# ============================================================================

# ── Supabase CMS (optional — leave blank for static-site-only mode) ──────

# From Supabase Dashboard → Settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (transactional email) ─────────────────────────────────────────

# From https://resend.com/api-keys
RESEND_API_KEY=

# ── Upstash Redis (rate limiting, optional) ──────────────────────────────

# From https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google Maps (embedded maps, optional) ─────────────────────────────────

NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Google Analytics 4 (optional) ─────────────────────────────────────────

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── Development Flags ─────────────────────────────────────────────────────

# Log emails to console instead of sending
USE_MOCK_EMAIL=true
